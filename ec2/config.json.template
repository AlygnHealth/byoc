{
    "host": "IPADDRESS",
    "bindPorts": {
      "publicHttp": 8082,
      "gossipHttp": 8081
    },
    "blobFetcher": {
      "bucket": "${services_bucket_name}",
      "awsConfig": {
          "region": "${region}"
      }
    },
    "userBlobFetcher": {
      "bucket": "${blob_bucket_name}",
      "awsConfig": {
          "region": "${region}"
      }
    },
    "vault": {
      "host": "${vault_host}",
      "port": 8200,
      "scheme": "http"
    },
    "environmentsMount": "${environments_mount}",
    "dynamo": {
      "type": "cloud",
      "region": "${region}",
      "table": "${dynamodb_table}"
    },
    "cloudApiInstances": [
      {
        "uri": "https://${cluster_name}.byoc.unison.cloud"
      }
    ],
    "cloudApiTcpConfig": { "type": "everybody" },
    "clusterMap": {}
}
